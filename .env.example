# ============================================================
#  AI 导航站 — 环境变量示例
#  复制为 .env 后按需修改（server/.env 优先被 Prisma 读取）
# ============================================================

# ---- 数据库 ----
# 默认 SQLite：零依赖，clone 后直接 npm run dev 即可运行
DB_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# 切换到 MySQL（生产推荐）：
#   1. 修改下面两行
#   2. 执行 pnpm db:migrate（会重建迁移）
# DB_PROVIDER="mysql"
# DATABASE_URL="mysql://ai_nav:ai_nav_pass@127.0.0.1:3306/ai_nav"

# ---- 服务端口 ----
PORT=3001

# ---- JWT ----
# 生产环境务必修改为随机长字符串
JWT_SECRET="please-change-me-in-production-8f3a9c2e1b"
JWT_EXPIRES_IN="7d"

# ---- 管理员初始账号（seed 时使用）----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"

# ---- 前端地址（CORS / 投稿回调）----
WEB_ORIGIN="http://localhost:5173"
