# ============================================================
#  AI 导航站 — 环境变量示例
#  复制为 .env 后按需修改
# ============================================================

# ---- 数据库 ----
# 生产用 Neon 免费 Postgres（推荐，无需信用卡）：
DB_PROVIDER="postgresql"
DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/db?sslmode=require"

# 本地零配置开发可切回 SQLite：
# DB_PROVIDER="sqlite"
# DATABASE_URL="file:./dev.db"

# ---- 服务端口 ----
PORT=3001

# ---- JWT ----
# 生产环境务必改为随机长字符串，生成命令：
#   openssl rand -hex 32
JWT_SECRET="please-change-me-in-production"
JWT_EXPIRES_IN="7d"

# ---- 管理员初始账号（seed 时使用）----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"

# ---- 前端地址（CORS）----
# 生产填 GitHub Pages 地址，多个来源用逗号分隔
WEB_ORIGIN="http://localhost:5173"
