{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // composite 项目必须开启声明产出，且不能设 noEmit。
    // allowImportingTsExtensions 要求 noEmit 或 emitDeclarationOnly，
    // 这里用 emitDeclarationOnly 满足该约束。
    "composite": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "global.d.ts"]
}
