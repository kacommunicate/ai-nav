# ============================================================
#  AI 导航站 — 环境变量示例
# ============================================================

# ---- 服务端口 ----
PORT=3001

# ---- 数据库 ----
# 本地开发默认 SQLite（零配置）
DB_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# 生产 / docker compose 使用 MySQL：
# DB_PROVIDER="mysql"
# DATABASE_URL="mysql://ai_nav:ai_nav_pass@127.0.0.1:3306/ai_nav"

# ---- JWT（生产务必修改为随机长字符串）----
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---- 初始管理员（seed 时创建）----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"

# ---- 前端地址（CORS）----
WEB_ORIGIN="http://localhost:5173"
